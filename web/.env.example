# Copy to .env.local for local dev. Vite only exposes VITE_-prefixed vars.

# Backend (Cloudflare Worker). Unset = run on the fixtures in src/mock.ts.
# VITE_BUNTS_API=https://bunts-backend.<subdomain>.workers.dev
# VITE_BUNTS_SECRET=<the APP_SECRET set with wrangler secret put>

# VAPID public key. Only needed to test push before the backend is deployed --
# once it is, the app fetches this from /push/key instead.
# VITE_VAPID_PUBLIC_KEY=
